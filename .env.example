# Test Environment Configuration for Document Scrape
TEST_ENV=local

# External test URLs for scraping tests
TEST_HTTPBIN_URL=https://httpbin.org
TEST_SCRAPING_TARGET=https://example.com

# Test file paths
TEST_DATA_DIR=./tests/fixtures/data
TEST_OUTPUT_DIR=./test-results

# Rate limiting for tests (be respectful to target sites)
TEST_REQUEST_DELAY_MS=1000
TEST_MAX_CONCURRENT_REQUESTS=5

# Feature flags for testing
TEST_ENABLE_LOGGING=true
TEST_ENABLE_RETRY_LOGIC=true
TEST_MOCK_EXTERNAL_REQUESTS=false